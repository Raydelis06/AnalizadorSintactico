<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Ventana1Controller"
      style="-fx-background-color: #1e1e2e;">

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT" >
        <Label text=" Analizador Léxico, Sintáctico y Semántico"
           style="-fx-text-fill: #cdd6f4; -fx-font-size: 16px; -fx-font-weight: bold;">
            <font><Font name="Consolas" size="16.0" /></font>
        </Label>

        <Button fx:id="btnAbrirArchivo"
                text="Abrir archivo"
                style="-fx-background-color: #343446;
                    -fx-text-fill: #89b4fa;
                    -fx-font-weight: bold;
                    -fx-font-size: 13px;
                    -fx-padding: 6 18 6 18;
                    -fx-border-radius: 4;
                    -fx-background-radius: 4;
                    -fx-cursor: hand;"/>
        <Button fx:id="btnGuardarArchivo"
                text="Guardar archivo"
                style="-fx-background-color: #343446;
                    -fx-text-fill: #89b4fa;
                    -fx-font-weight: bold;
                    -fx-font-size: 13px;
                    -fx-padding: 6 18 6 18;
                    -fx-border-radius: 4;
                    -fx-background-radius: 4;
                    -fx-cursor: hand;"/>
        
    </HBox>

    <!--  Área de código fuente -->
    <Label text="Código Fuente:"
           style="-fx-text-fill: #a1c6e3; -fx-font-size: 13px; -fx-font-weight: bold;" />

    <HBox fx:id="numberedArea">
        <ListView fx:id="listNumeros" 
                    prefWidth="60"
                    editable="false"
                    focusTraversable="false"
                    style="
                            -fx-control-inner-background: #313244;
                            -fx-border-radius: 4;
                            -fx-background-radius: 4;
                            -fx-border-color: #313244;">
        </ListView>
        <TextArea fx:id="txtInput"
            prefHeight="500"
            promptText="Escribe tu código aquí..."
            style="-fx-control-inner-background: #313244;
                    -fx-text-fill: #cdd6f4;
                    -fx-font-family: 'Consolas';
                    -fx-font-size: 13px;
                    -fx-border-color: #45475a;
                    -fx-border-radius: 4;
                    -fx-background-radius: 4;"
                    
            HBox.hgrow="ALWAYS">
            <VBox.margin><Insets /></VBox.margin>
        </TextArea>
    </HBox>
    

    <!-- Botón de análisis -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <Button fx:id="btnAnalizar"
                text=" Ejecutar Análisis"
                onAction="#analizarCodigo"
                style="-fx-background-color: #89b4fa;
                       -fx-text-fill: #1e1e2e;
                       -fx-font-weight: bold;
                       -fx-font-size: 13px;
                       -fx-padding: 6 18 6 18;
                       -fx-border-radius: 4;
                       -fx-background-radius: 4;
                       -fx-cursor: hand;" />

    </HBox>
    <!-- Panel de resultados (3 tabs) -->
    <Label text="Resultados:"
           style="-fx-text-fill: #a1c6e3; -fx-font-size: 13px; -fx-font-weight: bold;" />

    <TabPane tabClosingPolicy="UNAVAILABLE"
             VBox.vgrow="ALWAYS"
             style="-fx-background-color: #181825;
                    -fx-border-color: #45475a;
                    -fx-border-radius: 4;
                    -fx-tab-min-width: 160px;">

        <!-- Tab 1: Tokens del Lexer -->
        <Tab text=" Tokens (Léxico)">
            <content>
                <VBox style="-fx-background-color: #181825;">
                    <padding><Insets top="6" left="6" right="6" bottom="6" /></padding>
                    <ListView fx:id="listTokens"
                              VBox.vgrow="ALWAYS"
                              style="-fx-control-inner-background: #1e1e2e;
                                     -fx-font-family: 'Consolas';
                                     -fx-font-size: 12px;
                                     -fx-text-fill: #cdd6f4;
                                     -fx-border-color: #313244;" />
                </VBox>
            </content>
        </Tab>
        <!-- Tab 2: Estructura del programa -->
        <Tab text=" Estructura (Parser)">
            <content>
                <VBox style="-fx-background-color: #181825;">
                    <padding><Insets top="6" left="6" right="6" bottom="6" /></padding>
                    <Label text="Sentencias reconocidas por el parser y tabla de símbolos:"
                           style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                                  -fx-padding: 0 0 4 2;" />
                    <ListView fx:id="listEstructura"
                              VBox.vgrow="ALWAYS"
                              style="-fx-control-inner-background: #1e1e2e;
                                     -fx-font-family: 'Consolas';
                                     -fx-font-size: 12px;
                                     -fx-text-fill: #89dceb;
                                     -fx-border-color: #313244;" />
                </VBox>
            </content>
        </Tab>
        <!-- Tab 3: Consola de errores -->
        <Tab text=" Consola (Errores)">
            <content>
                <VBox style="-fx-background-color: #181825;">
                    <padding><Insets top="6" left="6" right="6" bottom="6" /></padding>
                    <Label text="Errores léxicos, sintácticos y semánticos detectados:"
                           style="-fx-text-fill: #6c7086; -fx-font-size: 11px;
                                  -fx-padding: 0 0 4 2;" />
                    <TextArea fx:id="txtConsola"
                              editable="false"
                              VBox.vgrow="ALWAYS"
                              style="-fx-control-inner-background: #1e1e2e;
                                     -fx-text-fill: #f38ba8;
                                     -fx-font-family: 'Consolas';
                                     -fx-font-size: 12px;
                                     -fx-border-color: #313244;" />
                </VBox>
            </content>
        </Tab>

    </TabPane>

</VBox>
