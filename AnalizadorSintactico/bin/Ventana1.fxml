<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Ventana1Controller">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label style="-fx-font-weight: bold;" text="Código Fuente:" />
        <TextArea fx:id="txtInput" prefHeight="150.0" promptText="Escribe tu código aquí (ej. x := 5)..." />
        <Button fx:id="btnAnalizar" mnemonicParsing="false" onAction="#analizarCodigo" text="Ejecutar Análisis" />
        <Label style="-fx-font-weight: bold;" text="Resultados:" />
        <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
            <tabs>
                <Tab text="Tokens (Lexer)">
                    <content>
                        <ListView fx:id="listTokens" prefHeight="200.0" prefWidth="200.0" />
                    </content>
                </Tab>
                <Tab text="Consola (Errores)">
                    <content>
                        <TextArea fx:id="txtConsola" editable="false" prefHeight="200.0" prefWidth="200.0" style="-fx-text-fill: red;" />
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</VBox>